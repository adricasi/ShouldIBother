# Settings for automatic deploys (T-042, guide section 14). Not secret: the registry login is
# stored by `docker login`, not here. Copy to /etc/sib/autodeploy.env (root-owned, 0600).

# The image repository in your DigitalOcean Container Registry:
# registry.digitalocean.com/<registry name>/<repository>
SIB_REGISTRY_REPOSITORY=registry.digitalocean.com/sib-registry/sib

# The tag the Droplet follows. Push a build to this tag to release it.
SIB_RELEASE_CHANNEL=prod
