erDiagram
  pairing ||--o{ sessions : "links up to 3 devices"
  cards ||--o{ quotes : "priced by"
  cards ||--o{ bets : "one active per card"
  cards ||--o{ photos : "before photo"
  bets ||--o{ photos : "after or appeal photo"
  bets ||--o{ settlements : "original + appeal"
  bets ||--o| settle_progress : "answer while settling"
  bets ||--o| cash_outs : "flag rescue"
  bets ||--o| rescue_checks : "flag rescue"
  gemma_decisions |o--o{ quotes : "decision_id"
  gemma_decisions |o--o{ bets : "decision_id"
