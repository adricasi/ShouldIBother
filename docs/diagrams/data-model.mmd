    int odds
    text odds_source
    int gemma_band
    int rule_band
    text model_version
    text prompt_version
    int decision_id FK
    int settle_at
    text status
  }
  settlements {
    int id PK
    int bet_id FK
    text evidence
    text verdict
    int lucky_win
    real multiplier
    int points
    int appeal_of FK
    int decision_id FK
  }
  settle_progress {
    int bet_id PK
    text evidence
  }
  photos {
    text id PK
    int card_id FK
    int bet_id FK
    text role
  }
  gemma_decisions {
    int id PK
    text job
    text model
    text tool_mode
    int valid
    text tool_result
  }
  pairing {
    int id PK
  }
  sessions {
    text id_hash PK
    text device
  }
  weather_cache {
    text key PK
  }
  model_calls {
    text day PK
