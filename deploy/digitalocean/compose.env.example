# Not secret. Copy to /opt/sib/.env on the Droplet (Compose reads it for ${...} in compose.yaml).

# The bare host name of the app, the same host as SIB_PUBLIC_ORIGIN in /etc/sib/sib.env.
SIB_HOST=sib.example.com

# The image tag you loaded with `docker load`. Change it to update or to roll back.
SIB_IMAGE_TAG=replace-with-the-tag-you-built
