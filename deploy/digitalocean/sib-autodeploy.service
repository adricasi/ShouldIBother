[Unit]
Description=Deploy a new Should I Bother? image from the registry, if there is one
Wants=docker.service network-online.target
After=docker.service network-online.target
# A failed deploy or rollback is logged loudly and leaves a marker file (guide 14).
OnFailure=sib-autodeploy-failed.service

[Service]
Type=oneshot
ExecStart=/opt/sib/autodeploy.sh
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
TimeoutStartSec=20min
