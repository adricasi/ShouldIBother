# Settings for deploy/digitalocean/release.sh (guide 14). Not secret. Copy to
# ~/.config/sib/release.env on the laptop:
#   mkdir -p ~/.config/sib && cp deploy/digitalocean/release.env.example ~/.config/sib/release.env

# How to reach the Droplet over SSH: user@<reserved IP>.
SIB_DROPLET=root@203.0.113.10

# The name of your DigitalOcean Container Registry (the part after registry.digitalocean.com/).
SIB_REGISTRY=sib-registry
