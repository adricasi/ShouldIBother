# Settings for the hosted app (SIB_MODE=hosted). Docs: docs/deploy-digitalocean.md.
#
# Keep the real file at /etc/sib/sib.env, owned by root, mode 0600:
#   install -m 0600 -o root -g root env.example /etc/sib/sib.env
# It holds the inference key. Never commit it, never paste it into a chat or an issue, and never
# copy it into a backup folder.
#
# Compose also sets SIB_DATA_DIR=/data and SIB_BIND_ADDRESS=0.0.0.0 for the app container.
# Leave SIB_PORT as it is: the Caddyfile points at port 8787.

# Switches the app to hosted mode. Any other value than "hosted" or "home" stops the app.
SIB_MODE=hosted

# The public https origin of the app: scheme and host only, no path and no trailing slash. It is
# the only Host and Origin the app accepts and the base of the pairing link.
SIB_PUBLIC_ORIGIN=https://sib.example.com

# The Gemma 4 model ID on DigitalOcean's inference service. ADR-0011 lists the ID the builder
# verified with `sib hosted-check`; the app refuses an ID that is not on that list.
SIB_DO_MODEL=gemma-4-31B-it

# A DigitalOcean model access key limited to inference, with a monthly budget (guide, step 3).
# Fill it in on the Droplet; leave it empty in any copy that leaves the Droplet.
SIB_DO_INFERENCE_KEY=

# 0 (default): photos are never sent to the model; bets settle by tap at x0.5.
# 1: photos are sent to DigitalOcean's inference service. Turn on only if `sib hosted-check`
#    reports that an image is accepted, and only if you accept that trade-off.
SIB_DO_VISION=0

# injected (default): the app calls get_forecast and hands Gemma the result.
# native: Gemma calls the tool itself. Use only if `sib hosted-check` reports that tool calls work.
SIB_TOOL_USE=injected

# The most chat-completion requests per Madrid day (retries and tool rounds count). From 80 %
# only judge verdicts use Gemma; at the cap verdicts wait for the next day.
SIB_DAILY_MODEL_CALLS=300

# The port the app listens on inside the container. Keep 8787.
SIB_PORT=8787

# SIB_TRUSTED_PROXY is set in compose.yaml (Caddy's fixed address, 172.30.10.2). Do not set it here.
